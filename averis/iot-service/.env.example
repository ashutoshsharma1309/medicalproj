# ===========================================================================
# AVERIS IoT service
#
# Never commit real values. This file documents the shape only.
# ===========================================================================

# Your Supabase project, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# The SERVICE ROLE key, which bypasses Row Level Security.
#
# This service is the only component in AVERIS that holds one, because a worker
# ingesting for the whole fleet cannot be scoped to a single signed-in user.
# It must never reach a browser, a client bundle, or the Next.js app — and it is
# why the ingest service exists as a separate process at all.
#
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Origins allowed to open the live WebSocket. Comma-separated.
# Not "*": the socket carries vital signs.
CORS_ORIGINS=http://localhost:3100

# Per device, not per IP — a ward behind one NAT shares an address.
MAX_READINGS_PER_MINUTE=60

LOG_LEVEL=info
