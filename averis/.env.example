# ============================================================================
# AVERIS — environment configuration
# Copy to `.env.local` and fill in. Never commit real values.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and the browser-safe publishable (anon) key. Both are exposed to
# the client by design — Row Level Security is what protects the data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Next.js only ships env vars prefixed with NEXT_PUBLIC_ to the browser, so the
# two values above are mirrored here for client-side use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never import this in client code,
# never prefix it with NEXT_PUBLIC_. Not required by Phase 1.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Authentication / OAuth
# ---------------------------------------------------------------------------
# Configured in the Supabase dashboard (Authentication → Providers → Google).
# Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google Cloud Platform
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=

# ---------------------------------------------------------------------------
# AI extraction (Phase 2) — server-only, never prefix with NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# AVERIS supports two providers with near-identical names. Set ONE key; the
# provider is inferred from its prefix.
#
#   Groq (groq.com)  keys begin `gsk_`  → https://api.groq.com/openai/v1
#                    open models: GPT-OSS, Llama, Qwen
#   Grok (x.ai)      keys begin `xai-`  → https://api.x.ai/v1
#
GROQ_API_KEY=
# GROK_API_KEY=            # alias, for an xAI key

# Optional overrides. Defaults: openai/gpt-oss-120b on Groq, grok-4 on xAI.
#
# gpt-oss-120b is the Groq default because it returns genuinely varied
# confidence scores. Llama 3.3 70B and Qwen 3.6 27B both returned a flat 1.0
# for every field on the same lab report, which would make the low-confidence
# review flagging meaningless.
# AI_MODEL=
# AI_BASE_URL=

# ---------------------------------------------------------------------------
# OCR (Phase 2 — images and scanned PDFs)
# ---------------------------------------------------------------------------
# "tesseract" (default, runs locally, no external dependency) or
# "google-vision" (better on photographed documents, needs the key below).
OCR_PROVIDER=tesseract
GOOGLE_CLOUD_VISION_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin, used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Platform (Phase 6)
# ---------------------------------------------------------------------------
# debug | info | warn | error. Defaults to debug outside production.
LOG_LEVEL=info

# Names the service in every log line. Set per deployment so the web and worker
# containers are distinguishable in an aggregator.
SERVICE_NAME=averis-web

# Shared cache and rate-limit counters.
#
# Unset falls back to in-process, which is correct for a single instance and
# wrong for several: rate limits would become per-container, multiplying every
# published limit by the number of running instances — and loosening exactly as
# traffic grows.
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Worker only (Phase 6)
# ---------------------------------------------------------------------------
# scripts/worker.ts needs SUPABASE_SERVICE_ROLE_KEY (declared above) because
# claiming jobs necessarily crosses patients. Never set it on the web service:
# anything holding that key reads every patient's records regardless of policy.
# WORKER_POLL_MS=5000
# WORKER_BATCH=1

# ---------------------------------------------------------------------------
# MLOps (Phase 6)
# ---------------------------------------------------------------------------
# Where training runs are recorded. Defaults to a local SQLite store at
# ml/mlruns/mlflow.db; point at a server to share them.
# MLFLOW_TRACKING_URI=http://localhost:5000

# ---------------------------------------------------------------------------
# Local docker compose only
# ---------------------------------------------------------------------------
# WEB_PORT=8080
# REDIS_PORT=6379
# MLFLOW_PORT=5000

# --------------------------------------------------------------- IoT (Phase 1)
# Where the browser opens the live monitoring socket. Public by necessity —
# it is a URL, and the device token authenticates the subscription.
NEXT_PUBLIC_IOT_WS_URL=ws://localhost:8000/api/live

# Where the simulator and firmware POST readings.
IOT_INGEST_URL=http://localhost:8000/api/device/data

# ---------------------------------------------------------------------------
# Demonstration mode
#
# Enables /demo: a guided, six-step checklist that verifies each stage of the
# pipeline against live data. It seeds nothing and mocks nothing — it tells you
# which simulator command to run and then checks what actually happened.
#
# Off by default, and it should stay off anywhere real patients are served.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_MODE=false
