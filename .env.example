# --- Database -------------------------------------------------------------
# PostgreSQL connection string (docker-compose provides this automatically)
DATABASE_URL="postgresql://meridian:meridian@localhost:5433/meridian?schema=public"

# --- Auth -------------------------------------------------------------------
# 32+ char random secret used to sign JWT session cookies
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# --- AI layer ---------------------------------------------------------------
# Anthropic API key. When absent, the platform runs in "deterministic mode":
# the rule-based clinical engines (risk, triage, interactions) still work and
# LLM narratives fall back to structured template output.
ANTHROPIC_API_KEY=""
# Model used for clinical reasoning / extraction / documentation
ANTHROPIC_MODEL="claude-opus-5"

# --- Cache (optional) --------------------------------------------------------
# Redis connection for response caching; falls back to in-process LRU if unset
REDIS_URL=""

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Meridian"
